# Frontend environment template. Local development only.
#
# EVERYTHING here is compiled into the public JavaScript bundle. Vite inlines
# every VITE_-prefixed value at build time, so treat this file as though its
# contents were printed on the home page - because effectively they are.
#
# NEVER put the Supabase *secret* key here, or in any VITE_ variable. That key
# is backend-only: it bypasses every row-level security policy, so exposing it
# would hand any visitor full read and write access to every user's data. It
# belongs in the backend environment and nowhere else.
#
# The same goes for database passwords, JWT secrets and access tokens.
# frontend/scripts/checkPrivilegeContainment.mjs fails the build if any
# privileged credential reaches this directory.

# Backend API origin. Leave unset to use the production default.
VITE_API_BASE_URL=http://localhost:5000

# Supabase project origin. A public identifier, safe to expose.
# Development project: https://xhxlgalaytuqdnmmwypv.supabase.co
# Production project:  https://jexphwidcfbgxpthgwum.supabase.co
VITE_SUPABASE_URL=https://xhxlgalaytuqdnmmwypv.supabase.co

# Publishable key. Designed to be public - it can read nothing on its own,
# because row-level security decides what exists for the signed-in user.
VITE_SUPABASE_PUBLISHABLE_KEY=
