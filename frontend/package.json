{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/checkCspHashes.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:accept-linux": "AZALENS_ACCEPT_BASELINES=1 playwright test --grep @visual --update-snapshots=changed",
    "test:contrast": "node scripts/checkContrast.mjs",
    "test:design-tokens": "node scripts/checkDesignTokens.mjs",
    "test:performance": "node scripts/checkPerformanceBudget.mjs",
    "test:csp": "node scripts/checkCspPolicy.mjs",
    "test:csp-hashes": "node scripts/checkCspHashes.mjs",
    "lint": "oxlint",
    "test": "vitest run && node scripts/checkBrandAssets.mjs",
    "test:brand": "node scripts/checkBrandAssets.mjs",
    "preview": "vite preview",
    "test:privilege": "node scripts/checkPrivilegeContainment.mjs",
    "visual:candidates": "node scripts/captureLandingCandidates.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.3",
    "axios": "^1.18.1",
    "cmdk": "^1.1.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
