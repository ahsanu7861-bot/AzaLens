# Playwright run artifacts. Regenerated by `npm run test:e2e`, so without this
# they reappear as untracked noise after every browser-test run and risk being
# swept into an unrelated commit.
test-results
playwright-report

# Landing visual candidate artifacts. Review evidence produced by
# scripts/captureLandingCandidates.mjs and uploaded from CI; never committed,
# and never an accepted baseline.
candidate-artifacts

