# Local development only. Never commit real credentials.
APP_ENV=development
NODE_ENV=development
SERVICE_VERSION=0.1.0-dev
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
PRIVATE_PERSONAL_PROVIDER_MODE=false
# Twelve Data transport is fail-closed unless all four settings below prove a
# single-instance deployment with a durable absolute ledger path. Never set the
# acknowledgements for autoscaling, multiple containers, or ephemeral storage.
TWELVE_DATA_CREDIT_COORDINATION_MODE=disabled
TWELVE_DATA_SINGLE_INSTANCE_ACK=false
TWELVE_DATA_CREDIT_LEDGER_PATH=
TWELVE_DATA_CREDIT_LEDGER_DURABLE_ACK=false
ALPHAVANTAGE_API_KEY=
OBSERVABILITY_METRICS_TOKEN=
SHARIAH_DATA_MODE=offline
HALAL_TERMINAL_ALLOW_LIVE_IN_DEV=false
FEATURE_SCANNER_ENABLED=false
FEATURE_PORTFOLIO_PRO_ENABLED=false
FEATURE_LIVE_SHARIAH_ENABLED=false

# ----------------------------------------------------------------------
# Supabase (backend). Required in staging and production; optional in
# development and test, but validated whenever any of the three is set.
#
# The project reference in SUPABASE_URL must match the environment:
#   development / test / staging -> xhxlgalaytuqdnmmwypv
#   production                   -> jexphwidcfbgxpthgwum
# The server refuses to start on a mismatch, so production can never be
# pointed at the development database or the reverse.
#
# Project references and origins below are public identifiers, not secrets.
# The two KEY values are secrets - never commit real ones.
#
# There is deliberately NO SUPABASE_JWT_ISSUER. The issuer is derived from
# SUPABASE_URL so the two cannot drift apart (design §4.3). Setting it is a
# validation error, not a silent override.
# ----------------------------------------------------------------------
SUPABASE_URL=https://xhxlgalaytuqdnmmwypv.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
